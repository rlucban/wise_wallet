# Cloud API endpoint (wallet-api)
# Default production:
EXPO_PUBLIC_API_URL=https://wallet-atog-api.vercel.app/api

# Local development (json-server on port 3000):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# SPEC-35 admin flag: login database-reset button. Exact "true" enables
# (requires rebuild); false/absent = off. Ships OFF — do not enable.
EXPO_PUBLIC_ADMIN_TOGGLE=true